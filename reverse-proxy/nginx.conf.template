# Rendered into /etc/nginx/conf.d/default.conf by the stock nginx image's
# own docker-entrypoint.d/20-envsubst-on-templates.sh - included inside that
# image's existing http{} block (its default nginx.conf's `include
# /etc/nginx/conf.d/*.conf;`), so this file is a server-block fragment only,
# not a standalone config - no events{}/http{} wrapper here, those already
# exist upstream and nesting them would fail `nginx -t`.

# Raised for OpenEMR document uploads.
client_max_body_size 64m;

# Upstreams are held in variables and resolved by this resolver at REQUEST
# time, not baked in as literal proxy_pass hostnames resolved once at config
# load. A literal hostname makes `nginx -t`/startup fail hard the moment that
# name isn't resolvable yet (confirmed locally - a sibling container starting
# slower than nginx hits exactly this) instead of just failing the individual
# request. DNS_RESOLVER is detected from /etc/resolv.conf at container start by
# docker-entrypoint.d/10-resolver.envsh (set it explicitly to override), and
# ipv6=off keeps nginx on A records because both upstreams are IPv4-only - see
# the Dockerfile for both.
resolver ${DNS_RESOLVER} valid=10s ipv6=${RESOLVER_IPV6};

# ---- Edge rate limits: THE ONE PLACE every front-door limit lives ----
#
# WHO "a client" is. Behind Railway the TCP peer is Railway's edge (100.64.0.0/10, the CGNAT range -
# every access-log line on staging shows a 100.64.0.x peer), so keying on it would put every user in a
# handful of buckets. The edge sets X-Real-IP to the connecting client; it is believed ONLY when the peer
# is inside REAL_IP_TRUSTED_CIDR, so a client that sends its own X-Real-IP straight at an untrusted
# address is keyed on its own address, not on what it wrote. Not X-Forwarded-For: Railway appends its own
# edge address last there, so a recursive XFF walk trusting only 100.64/10 lands on the edge, not the client.
# Under compose the peer is the Docker bridge, outside the default CIDR, so the header is ignored there.
#
# WHAT is limited, by path, case-insensitively on the decoded $uri - the sidecar routes case-insensitively,
# so a case-sensitive match would let /agentforge/Evidence/ask walk past it. An empty
# key is not counted, so every other route - the SMART launches, the drill-down, static assets and all of
# OpenEMR at / (the sidecar's own FHIR calls come through here) - is never limited.
#   chat      /agentforge/hubs/chat*  SignalR negotiate + WebSocket upgrade (+ SSE sends if it falls back).
#             A WebSocket's messages are not HTTP requests, so this bounds connections, not turns; the
#             per-session LLM budget in the sidecar bounds turns (ConversationBudget).
#   evidence  /agentforge/evidence/*  /evidence/ask (an LLM call per request) and the source-document fetch.
#   agenda    /agentforge/agenda      the roster: a FHIR fan-out per rostered patient on EVERY load, and an LLM
#             summary for each one the sidecar's summary cache does not hold.
#             Only the roster fetch - /agenda/launch, /agenda/callback, /agenda/select-patient and
#             agenda.html itself do no LLM work and stay out.
#   ready     /agentforge/ready       unauthenticated; every call probes Postgres and Prometheus, and OpenEMR,
#             the LLM provider and Cohere at most once per Readiness__ResultCacheTtl. /health is
#             liveness only and cheap, so it is not limited.
#   ingest    /agentforge/documents/* is not here because it never reaches the sidecar through this door:
#             it is an unconditional 404 below (W2-D17). Its private-network path skips nginx entirely.
# Sizing is in DEPLOYMENT.md's "Edge rate limits and the per-session LLM budget"; the behaviour is pinned by
# nginx-behavior-selftest.sh.
map $uri $af_chat_client {
    "~*^/agentforge/hubs/chat"  $binary_remote_addr;
    default                     "";
}
map $uri $af_evidence_client {
    "~*^/agentforge/evidence/"  $binary_remote_addr;
    default                     "";
}
map $uri $af_agenda_client {
    "~*^/agentforge/agenda/?$"  $binary_remote_addr;
    default                     "";
}
map $uri $af_ready_client {
    "~*^/agentforge/ready(/|$)" $binary_remote_addr;
    default                     "";
}
limit_req_zone $af_chat_client     zone=af_chat:10m     rate=60r/m;
limit_req_zone $af_evidence_client zone=af_evidence:10m rate=20r/m;
limit_req_zone $af_agenda_client   zone=af_agenda:10m   rate=10r/m;
limit_req_zone $af_ready_client    zone=af_ready:10m    rate=30r/m;

server {
    listen ${PORT};

    set_real_ip_from ${REAL_IP_TRUSTED_CIDR};
    real_ip_header X-Real-IP;

    # Server level, so every location inherits all four; none defines its own limit_req.
    limit_req zone=af_chat burst=30 nodelay;
    limit_req zone=af_evidence burst=10 nodelay;
    limit_req zone=af_agenda burst=5 nodelay;
    limit_req zone=af_ready burst=10 nodelay;
    limit_req_status 429;
    limit_req_log_level warn;

    # SignalR - matched before the generic /agentforge/ block so the
    # Upgrade/Connection headers only apply to the websocket path, not every
    # sidecar request. The client pins WebSockets | ServerSentEvents and no
    # longer falls back to long-polling - but without
    # these headers the WebSocket upgrade itself fails, and the client
    # silently falls back to Server-Sent Events over this same route. A
    # missing-header mistake here is still quiet, not loud; it only fails
    # outright if SSE fails too.
    #
    # proxy_pass has no trailing URI here deliberately - the full original
    # path (/agentforge/hubs/chat, prefix included) passes through unchanged.
    # The sidecar strips the prefix itself via UsePathBase("/agentforge"),
    # not this proxy; a trailing "/" here would make nginx rewrite the prefix
    # away before forwarding, leaving the sidecar's own PathBase never matched
    # (confirmed locally - a trailing-slash version served the sidecar's root
    # instead of its /agentforge-prefixed route).
    location /agentforge/hubs/chat {
        set $sidecar_upstream ${SIDECAR_UPSTREAM};
        proxy_pass http://$sidecar_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Long-lived connection, not a single request/response.
        proxy_read_timeout 3600s;
    }

    # Dotfiles are never served through the front door, whichever upstream holds them: OpenEMR's docroot
    # answers /.gitmodules (a scanner baseline finding) and would answer any other /.git*, /.env or
    # /.htaccess that lands there. Any path segment starting with a dot, at any depth, EXCEPT .well-known:
    # SMART and OIDC discovery live under it (/apis/{site}/fhir/.well-known/smart-configuration, which the
    # sidecar's readiness probe reads, and /oauth2/{site}/.well-known/openid-configuration). The (/|$)
    # stops a /.well-known-anything spelling from riding that exception. Matched on the decoded, normalised
    # $uri, so /%2egitmodules is caught too. The FIRST regex location, so it outranks every other one and
    # every prefix location (none here is ^~). 404, not 403, like the blocks below.
    location ~ /\.(?!well-known(/|$)) {
        return 404;
    }

    # The ingestion endpoint lives under the sidecar's /agentforge PathBase but must NOT be reachable
    # through the public front door: it authenticates by trusted private-network origin (W2-D17) and the
    # cron reaches it directly over the container network. Case-insensitive regex, which takes precedence
    # over the /agentforge/ prefix below (it is not ^~): the sidecar matches paths case-insensitively
    # (UsePathBase + endpoint routing), so a case-sensitive prefix would let /agentforge/Documents/* fall
    # through and reach the sidecar - the same bypass closed on /agentforge/metrics. 404 (not 403)
    # to avoid advertising the route. reference: ARCHITECTURE-DOCUMENTS.md §15 W2-D17.
    location ~* ^/agentforge/documents/ {
        return 404;
    }

    # The sidecar's Prometheus exposition endpoint (MapPrometheusScrapingEndpoint, unauthenticated
    # by design) must not be reachable from outside the network - it has no auth of its own, same
    # reasoning as the block above. Prometheus itself never comes through here: it scrapes the sidecar
    # directly over the private network, straight at Kestrel (reverse-proxy:${SIDECAR_PORT:-8081} under
    # compose, agent-forge-api:8080 on Railway), which is a different port than this listener and was
    # never routed through this location.
    # 404 (not 403) for the same reason as /agentforge/documents/ - don't advertise the route.
    # Case-insensitive regex because the sidecar's routing is: UsePathBase("/agentforge") and endpoint
    # routing both match paths case-insensitively, so a case-sensitive prefix location would let
    # /agentforge/METRICS (or a percent-encoded upper-case letter that decodes to one) fall through to
    # /agentforge/ below and reach the sidecar. A ~* regex takes precedence over that prefix location
    # (it is not ^~), and (/|$) also catches the trailing-slash spelling.
    location ~* ^/agentforge/metrics(/|$) {
        return 404;
    }

    # /evidence/ask needs no special proxy rule: it is proxied to the sidecar via the generic /agentforge/
    # block below and gated there by the BFF session, exactly like /agenda and /patient (401 without a
    # launch). This supersedes an earlier proxy-layer 404 - authenticating the
    # endpoint in the sidecar removes the reason it was ever an outlier.

    # Everything else the sidecar serves (chat SPA, launch/callback, API).
    # Timeout is above AgentOptions.TurnDeadline's 90s default so a
    # slow-but-legitimate agent turn isn't cut off by the proxy before the
    # sidecar's own deadline would apply. No trailing URI on proxy_pass here
    # either - same prefix-preservation reasoning as the hubs/chat block above.
    location /agentforge/ {
        set $sidecar_upstream ${SIDECAR_UPSTREAM};
        proxy_pass http://$sidecar_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    # Grafana Live's websocket - matched before the generic /grafana block below for exactly
    # the reason /agentforge/hubs/chat is matched before /agentforge/: the Upgrade/Connection
    # headers belong to this one path, not to every dashboard request. Without it the browser's
    # Live connection arrives at Grafana as a plain request, Grafana rejects the handshake, and
    # the UI retries in a loop that reads as a proxy fault rather than an unproxied path.
    # Same empty-upstream guard and same no-trailing-URI rule as the block below.
    location /grafana/api/live/ws {
        set $grafana_upstream "${GRAFANA_UPSTREAM}";
        if ($grafana_upstream = "") {
            return 404;
        }
        proxy_pass http://$grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Long-lived connection, not a single request/response.
        proxy_read_timeout 3600s;
    }

    # Grafana, so the dashboard is reached through this front door rather than needing a
    # published origin of its own - one place to reason about what is internet-facing.
    #
    # AN EMPTY UPSTREAM IS A FIRST-CLASS CASE HERE, NOT A MISCONFIGURATION, and the quotes
    # around the placeholder are what make it one. Grafana is declared only where
    # OBSERVABILITY_IMAGES carries pins (staging today), so on production and under compose
    # there is no grafana service and GRAFANA_UPSTREAM renders empty. Unquoted that is
    # `set $grafana_upstream ;` - a config-time syntax error that would stop nginx starting at
    # all; quoted it is `set $grafana_upstream "";`, which parses, and the request-time test
    # below answers 404. So this route is absent rather than broken where Grafana does not
    # exist, instead of 502ing at a name that resolves to nothing. `return` is one of the two
    # directives that are safe inside `if` in a location.
    #
    # proxy_pass carries no trailing URI, same reason as /agentforge/ above: Grafana is told it
    # lives under /grafana (GF_SERVER_ROOT_URL + GF_SERVER_SERVE_FROM_SUB_PATH in
    # .railway/railway.ts), so it wants the prefix it was sent, not one nginx rewrote away.
    # reference: DEPLOYMENT.md § "Observability: three wirings"
    location /grafana {
        set $grafana_upstream "${GRAFANA_UPSTREAM}";
        if ($grafana_upstream = "") {
            return 404;
        }
        proxy_pass http://$grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Everything else goes to OpenEMR - the front door's default upstream.
    location / {
        set $openemr_upstream ${OPENEMR_UPSTREAM};
        proxy_pass http://$openemr_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
